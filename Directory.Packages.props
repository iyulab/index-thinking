<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft.Extensions.AI -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <!-- Tokenization -->
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.1" />
    <!-- Security pin: Microsoft.ML.Tokenizers.Data.* 2.0.0 floats Microsoft.Bcl.Memory >=9.0.4,
         resolving to vulnerable 9.0.4 (NU1903 / GHSA-73j8-2gch-69rq / CVE-2026-26127, Base64Url
         OOB-read DoS). Pin patched 10.0.8 (>=10.0.4) so the fix flows to IndexThinking consumers. -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.14" />
    <!-- Distributed Caching -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <!-- Health Checks -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.14" />
    <!-- Dependency Injection -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- Samples -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <!-- AI Providers for Simulation Tests -->
    <PackageVersion Include="Anthropic" Version="13.3.0" />
    <PackageVersion Include="GeminiDotnet.Extensions.AI" Version="0.28.0" />
    <!-- Testing (xUnit v3 / Microsoft.Testing.Platform) -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <!-- Source Link -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
      <!-- Convention checks (options reachability) — iyulab conventions kit -->
    <PackageVersion Include="Iyu.Conventions.Testing" Version="0.13.0" />
  </ItemGroup>
</Project>